{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!assets", "!.vscode"]
  },
  "formatter": {
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "correctness": {
        "noPrivateImports": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/toolbelt/**"],
                "message": "This reaches inside the toolbelt. Import its entry as \"#toolbelt\" (ADR-0003)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.json"],
      "formatter": { "indentStyle": "space", "indentWidth": 2 }
    }
  ]
}
