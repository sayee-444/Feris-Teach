{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!assets", "!.vscode"]
  },
  "formatter": {
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": ["**/*.json"],
      "formatter": { "indentStyle": "space", "indentWidth": 2 }
    }
  ]
}
